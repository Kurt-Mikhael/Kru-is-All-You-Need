# Wajib — Groq API key (https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Database (default SQLite; ganti ke Postgres bila perlu)
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/trip_continuity

# Monitor
MONITOR_ENABLED=true
MONITOR_INTERVAL_MINUTES=5
MONITOR_TRIGGER_SCORE=65

# Atlas API (https://www.atriptech.com)
CLIENT_KEY=
SECRET_KEY=
WEBHOOK_URL=
